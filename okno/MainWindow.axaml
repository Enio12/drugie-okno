<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="okno.MainWindow"
        Title="okno"
        Width="600"
        Height="400"
        Background="LightBlue"
        BorderBrush="Navy"
        BorderThickness="4">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Plik">
                <MenuItem Header="_Nowy"/>
                <MenuItem Header="_Otwórz"/>
                <Separator/>
                <MenuItem Header="Za_mknij"/>
            </MenuItem>
            <MenuItem Header="_Edycja">
                <MenuItem Header="_Cofnij"/>
                <MenuItem Header="_Ponów"/>
            </MenuItem>
            <MenuItem Header="P_omoc">
                <MenuItem Header="_O programie"/>
            </MenuItem>
        </Menu>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="20">
            <Border BorderBrush="Navy"
                    BorderThickness="2"
                    CornerRadius="4"
                    Padding="20,10"
                    HorizontalAlignment="Center">
                <TextBlock Text="Warsztat"
                           FontSize="32"
                           FontFamily="Arial"
                           Foreground="Black"/>
            </Border>

            <CheckBox Content="Gotowe"
                      HorizontalAlignment="Center"
                      Foreground="Black"/>
        </StackPanel>
    </DockPanel>
</Window>
